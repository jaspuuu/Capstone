// ORGanIZE - LSPU-OSAS Student Organization Management System
// Core foundation schema: accounts/RBAC, colleges, organizations,
// recognition & renewal lifecycle, deadlines, sessions, audit log.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Accounts & access control
// ---------------------------------------------------------------------------

enum Role {
  OSAS
  SOA
  DEAN
  ADVISER_REGULAR
  ADVISER_PARTTIME
  PRESIDENT
  SECRETARY
  MEMBER
}

// Lifecycle of a person's account. A permanent account is independent of the
// positions they hold inside organizations (officer/adviser authority comes
// from memberships and assignments, not from the account). `isActive` on User
// is the denormalized usable-flag kept in sync with this status so existing
// `.isActive` filters stay cheap and unchanged.
enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ARCHIVED
}

model User {
  id                 String      @id @default(cuid())
  email              String      @unique
  passwordHash       String
  firstName          String
  lastName           String
  middleName         String?
  role               Role
  // Administrative scope (OSAS/SOA may be campus-wide; Dean scoped to college)
  collegeId          String?
  college            College?    @relation("UserCollege", fields: [collegeId], references: [id])
  departmentId       String?
  department         Department? @relation("UserDepartment", fields: [departmentId], references: [id])
  studentNumber      String?     @unique
  positionTitle      String?
  isActive           Boolean     @default(true)
  accountStatus      AccountStatus @default(ACTIVE)
  isViewOnly         Boolean     @default(false)
  // Set when an admin issues a temporary password; the user must change it
  // before they can use the system.
  mustChangePassword Boolean     @default(false)
  lastLoginAt        DateTime?
  // Saved e-signature (drawn, uploaded, or typed). At most one of image/typed
  // is set; method records which input produced it. Null = no signature yet.
  signatureImage     String?
  signatureTyped     String?
  signatureMethod    String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  sessions                     Session[]
  memberships                  OrganizationMember[]
  adviserAssignments           AdviserAssignment[]
  deanOfColleges               College[]              @relation("CollegeDean")
  auditLogs                    AuditLog[]
  recognitionEvents            RecognitionEvent[]     @relation("RecognitionEventActor")
  decidedRecognitions          Recognition[]          @relation("RecognitionDecidedBy")
  decidedProposals             ActivityProposal[]     @relation("ProposalDecidedBy")
  decidedReports               AccomplishmentReport[] @relation("ReportDecidedBy")
  updatedMonitoring            ActivityMonitoring[]   @relation("MonitoringUpdatedBy")
  createdDeadlines             Deadline[]             @relation("DeadlineCreator")
  uploadedAttachments          Attachment[]           @relation("AttachmentUploader")
  notifications            Notification[]         @relation("NotificationRecipient")
  notificationPreferences  NotificationPreference[] @relation("NotificationPreferenceOwner")
  attendanceRecords            ActivityAttendance[]   @relation("ActivityAttendanceUser")
  recordedAttendance           ActivityAttendance[]   @relation("ActivityAttendanceRecorder")
  decisionsEvaluations         ActivityEvaluation[]   @relation("ActivityEvaluationEvaluator")
  createdCheckIns              ActivityCheckIn[]      @relation("CheckInCreator")
  decidedMemberships           OrganizationMember[]   @relation("MembershipDecidedBy")
  endedAdviserTerms            AdviserAssignment[]    @relation("AdviserAssignmentEnder")
  createdSignatureRoutes       SignatureRoute[]       @relation("SignatureRouteCreator")
  signatureSteps               SignatureStep[]        @relation("SignatureStepSigner")
  actedSignatureSteps          SignatureStep[]        @relation("SignatureStepActor")
  createdFinancialRequirements FinancialRequirement[] @relation("FinancialRequirementCreator")
  createdFinancialSubmissions  FinancialSubmission[]  @relation("FinancialSubmissionCreator")
  decidedFinancialSubmissions  FinancialSubmission[]  @relation("FinancialSubmissionDecidedBy")
  archivedFinancialSubmissions FinancialSubmission[]  @relation("FinancialSubmissionArchiver")
  financialComments            FinancialComment[]     @relation("FinancialCommentAuthor")
  completedFollowUps           RecognitionFollowUp[]  @relation("FollowUpCompleter")

  @@index([role])
  @@index([collegeId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model College {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  deanId    String?
  dean      User?    @relation("CollegeDean", fields: [deanId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments   Department[]
  organizations Organization[]
  users         User[]         @relation("UserCollege")
  deadlines     Deadline[]
}

model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations Organization[]
  users         User[]         @relation("UserDepartment")

  @@unique([collegeId, name])
}

// ---------------------------------------------------------------------------
// Organizations
// ---------------------------------------------------------------------------

enum OrgType {
  MOTHER
  CHILD
  INDEPENDENT
}

enum OrgStatus {
  ACTIVE
  INACTIVE
}

// Creation/review lifecycle for a new organization application. The
// President creates the org as DRAFT, submits it for review, and it passes
// through adviser → dean → SOA → OSAS before OSAS confers recognition
// (RECOGNIZED). RECOGNIZED is the terminal application state and maps to the
// visible "Recognized / Active" state.
enum OrgApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  FOR_SIGNATURE
  FOR_APPROVAL
  APPROVED
  RECOGNIZED
  RETURNED
  REJECTED
}

enum MemberPosition {
  PRESIDENT
  VICE_PRESIDENT
  SECRETARY
  TREASURER
  AUDITOR
  PUBLIC_INFORMATION_OFFICER
  BUSINESS_MANAGER
  MEMBER
  OTHER
}

// Membership lifecycle: students apply, officers review, approved members
// participate. Statuses track the full lifecycle; REMOVED is a soft-delete
// that preserves history (§24).
enum MembershipStatus {
  APPLIED
  UNDER_REVIEW
  APPROVED
  ACTIVE
  INACTIVE
  REJECTED
  REMOVED
}

enum AdviserType {
  REGULAR
  PART_TIME
}

// Interview workflow stage for organization application / recognition /
// renewal (client-defined application process).
enum InterviewStatus {
  NOT_SCHEDULED
  SCHEDULED
  COMPLETED
  FOR_ADDITIONAL_REVIEW
  PASSED
  NEEDS_REVISION
}

model Organization {
  id                String               @id @default(cuid())
  name              String
  acronym           String?
  description       String?
  type              OrgType              @default(INDEPENDENT)
  parentId          String?
  parent            Organization?        @relation("OrgHierarchy", fields: [parentId], references: [id])
  children          Organization[]       @relation("OrgHierarchy")
  collegeId         String
  college           College              @relation(fields: [collegeId], references: [id])
  departmentId      String?
  department        Department?          @relation(fields: [departmentId], references: [id])
  status            OrgStatus            @default(ACTIVE)
  // President-driven application lifecycle: DRAFT → SUBMITTED → review chain.
  applicationStatus OrgApplicationStatus @default(DRAFT)
  submittedAt       DateTime?
  // Reviewer note on returned/rejected applications.
  applicationRemark String?
  decidedAt         DateTime?
  decidedById       String?
  // §Interview: interview is a first-class stage of the organization
  // application process (mirrors the Recognition interview fields).
  interviewStatus   InterviewStatus      @default(NOT_SCHEDULED)
  interviewAt       DateTime?
  interviewNotes    String?
  foundedYear       Int?
  // Organization-uploaded identity asset (file in storage/uploads).
  logoStoredName    String?
  archivedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  advisers             AdviserAssignment[]
  members              OrganizationMember[]
  recognitions         Recognition[]
  activities           ActivityProposal[]
  reports              AccomplishmentReport[]
  financialSubmissions FinancialSubmission[]
  notifications        Notification[]         @relation("NotificationOrg")

  @@index([collegeId])
  @@index([type])
  @@index([status])
  @@index([applicationStatus])
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  position       MemberPosition   @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  academicYear   String
  isCurrent      Boolean          @default(true)
  joinedAt       DateTime         @default(now())
  decidedAt      DateTime?
  decidedById    String?
  decidedBy      User?            @relation("MembershipDecidedBy", fields: [decidedById], references: [id])

  @@unique([organizationId, userId, academicYear])
  @@index([userId])
}

model AdviserAssignment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adviserId      String
  adviser        User         @relation(fields: [adviserId], references: [id], onDelete: Cascade)
  type           AdviserType
  academicYear   String
  isCurrent      Boolean      @default(true)
  assignedAt     DateTime     @default(now())
  // Succession: the outgoing adviser keeps their row; isCurrent flips false.
  endedAt        DateTime?
  endedById      String?
  endedBy        User?        @relation("AdviserAssignmentEnder", fields: [endedById], references: [id])
  endReason      String?

  @@unique([organizationId, type, academicYear, adviserId])
  @@index([adviserId])
}

// ---------------------------------------------------------------------------
// Recognition / accreditation / renewal lifecycle
// ---------------------------------------------------------------------------

enum RecognitionKind {
  INITIAL
  RENEWAL
}

enum RecognitionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  FOR_SIGNATURE
  FOR_APPROVAL
  APPROVED
  RECOGNIZED
  RETURNED
  REJECTED
  EXPIRED
}

model Recognition {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind            RecognitionKind   @default(INITIAL)
  academicYear    String
  status          RecognitionStatus @default(DRAFT)
  // Interview is a first-class workflow stage, visible in the tracker.
  interviewStatus InterviewStatus   @default(NOT_SCHEDULED)
  interviewAt     DateTime?
  interviewNotes  String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  decidedAt       DateTime?
  decidedById     String?
  decidedBy       User?             @relation("RecognitionDecidedBy", fields: [decidedById], references: [id])
  remarks         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  events   RecognitionEvent[]
  followUp RecognitionFollowUp?

  @@unique([organizationId, academicYear])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Follow-up (§24): the official work instruction requires a follow-up one week
// after submission for every application. Expected date is derived from the
// recognition's submittedAt (automated), status/notes are recorded here.
// ---------------------------------------------------------------------------

enum FollowUpStatus {
  PENDING
  CONTACTED
  COMPLETED
  OVERDUE
  SKIPPED
}

model RecognitionFollowUp {
  id             String           @id @default(cuid())
  recognitionId  String           @unique
  recognition    Recognition      @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  // Automated: submission date + 7 days (one-week follow-up window).
  expectedDate   DateTime
  status         FollowUpStatus   @default(PENDING)
  notes          String?
  completedAt    DateTime?
  completedById  String?
  completedBy    User?            @relation("FollowUpCompleter", fields: [completedById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([expectedDate])
}

model RecognitionEvent {
  id            String             @id @default(cuid())
  recognitionId String
  recognition   Recognition        @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         User?              @relation("RecognitionEventActor", fields: [actorId], references: [id])
  action        String
  fromStatus    RecognitionStatus?
  toStatus      RecognitionStatus?
  note          String?
  createdAt     DateTime           @default(now())

  @@index([recognitionId])
}

// ---------------------------------------------------------------------------
// Activity proposals & accomplishment reports
// Lifecycle mirrors recognition: officers file, adviser endorses, college or
// university authorities approve. Histories are kept in AuditLog.
// ---------------------------------------------------------------------------

enum ActivityScope {
  ORGANIZATION
  COLLEGE
  UNIVERSITY
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  ENDORSED
  APPROVED
  RETURNED
  REJECTED
}

// Activity lifecycle phase: tracks where an activity is in its overall
// lifecycle, independent of the proposal approval status.
enum ActivityPhase {
  PLAN
  PROPOSAL
  APPROVAL
  IMPLEMENTATION
  MONITORING
  ACCOMPLISHMENT
  ARCHIVE
}

// Monitoring & evaluation outcome (M&E). RECORDED after the activity window
// passes; IMPLEMENTED is the single status that unlocks an accomplishment
// report for the activity.
enum MonitoringStatus {
  IMPLEMENTED
  NOT_IMPLEMENTED
  RESCHEDULED
}

model ActivityProposal {
  id                   String         @id @default(cuid())
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYear         String
  title                String
  description          String
  objectives           String?
  venue                String?
  startAt              DateTime
  endAt                DateTime
  scope                ActivityScope  @default(ORGANIZATION)
  estimatedBudget      Float?
  expectedParticipants Int?
  status               ProposalStatus @default(DRAFT)
  phase                ActivityPhase  @default(PLAN)
  submittedAt          DateTime?
  decidedAt            DateTime?
  decidedById          String?
  decidedBy            User?          @relation("ProposalDecidedBy", fields: [decidedById], references: [id])
  remarks              String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  report            AccomplishmentReport?
  attendanceRecords ActivityAttendance[]
  checkIn           ActivityCheckIn?
  evaluation        ActivityEvaluation?
  monitoring        ActivityMonitoring?

  @@index([organizationId])
  @@index([status])
  @@index([academicYear])
  @@index([organizationId, academicYear])
}

// ---------------------------------------------------------------------------
// Attendance & participation (§Part 6). Roster rows overlay the organization's
// current membership; QR check-in is a lightweight presence proof.
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum AttendanceSource {
  MANUAL
  QR_CHECKIN
}

model ActivityAttendance {
  id           String           @id @default(cuid())
  activityId   String
  activity     ActivityProposal @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation("ActivityAttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  status       AttendanceStatus @default(PRESENT)
  source       AttendanceSource @default(MANUAL)
  recordedById String?
  recordedBy   User?            @relation("ActivityAttendanceRecorder", fields: [recordedById], references: [id])
  remarks      String?
  recordedAt   DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([activityId, userId])
  @@index([activityId])
}

model ActivityCheckIn {
  id          String           @id @default(cuid())
  activityId  String           @unique
  activity    ActivityProposal @relation(fields: [activityId], references: [id], onDelete: Cascade)
  // Random token embedded in the QR code; only holders of the scanned link
  // can check in while the window is open.
  token       String           @unique
  closedAt    DateTime?
  createdById String
  createdBy   User             @relation("CheckInCreator", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
}

// ---------------------------------------------------------------------------
// Monitoring & evaluation (M&E). One explicit, rubric-based evaluation per
// activity, entered by an analytics/OSAS officer after the activity ends.
// Every dimension is a 1-5 score; no rating is ever invented by the system.
// ---------------------------------------------------------------------------

model ActivityEvaluation {
  id             String           @id @default(cuid())
  activityId     String           @unique
  activity       ActivityProposal @relation(fields: [activityId], references: [id], onDelete: Cascade)
  evaluatorId    String
  evaluator      User             @relation("ActivityEvaluationEvaluator", fields: [evaluatorId], references: [id])
  // 1-5 rubric scores (validated in the server action).
  relevance      Int
  impact         Int
  efficiency     Int
  sustainability Int
  remarks        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([activityId])
}

// ---------------------------------------------------------------------------
// M&E outcome record. One row per activity (1:1), captured after the planned
// window. RESCHEDULED keeps the original startAt untouched; the new date and
// the full change history are preserved here.
// ---------------------------------------------------------------------------

model ActivityMonitoring {
  id                  String           @id @default(cuid())
  activityId          String           @unique
  activity            ActivityProposal @relation(fields: [activityId], references: [id], onDelete: Cascade)
  status              MonitoringStatus @default(NOT_IMPLEMENTED)
  // Required for NOT_IMPLEMENTED and RESCHEDULED; optional otherwise.
  reason              String?
  // New target date when RESCHEDULED (original startAt is never overwritten).
  rescheduledTo       DateTime?
  // Optional "responsible person" note (member/officer/adviser) left free-form.
  responsibleNote     String?
  // Persistent snapshot of the selected responsible member/adviser ids.
  responsibleMemberIds Json?
  // Ordered history of reschedules: [{from, to, reason, at}].
  rescheduleHistory   Json?
  updatedById         String
  updatedBy           User             @relation("MonitoringUpdatedBy", fields: [updatedById], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([status])
  @@index([activityId, status])
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  RETURNED
}

model AccomplishmentReport {
  id                 String            @id @default(cuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Optional link: reports may document an approved proposal or stand alone
  // for unplanned activities (configurable policy).
  activityProposalId String?           @unique
  activityProposal   ActivityProposal? @relation(fields: [activityProposalId], references: [id])
  academicYear       String
  title              String
  narrative          String
  heldOn             DateTime
  duration           String?
  location           String?
  conductedBy        String?
  actualParticipants Int?
  actualBudget       Float?
  budgetRemarks      String?
  status             ReportStatus      @default(DRAFT)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  decidedById        String?
  decidedBy          User?             @relation("ReportDecidedBy", fields: [decidedById], references: [id])
  remarks            String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  participants ReportParticipant[]

  @@index([organizationId])
  @@index([status])
  @@index([academicYear])
  @@index([organizationId, academicYear])
}

// Roster of who actually took part, snapshot at report time so it survives
// later membership churn. isOfficer marks the President/Secretary board rows.
model ReportParticipant {
  id            String               @id @default(cuid())
  reportId      String
  report        AccomplishmentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  // Nullable: unplanned reports may record participants by name only.
  memberId      String?
  name          String
  positionLabel String?
  isOfficer     Boolean              @default(false)
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())

  @@index([reportId])
}

// ---------------------------------------------------------------------------
// Document signature routing (§7-§11). Each routed document gets a Route with
// an ordered list of Steps. The sequence is form-specific (FORM_ROUTES) and
// strictly enforced: a step stays LOCKED until the previous one is SIGNED.
// ---------------------------------------------------------------------------

// Signatory slots. SENIOR_ADVISER maps to the org's current REGULAR adviser,
// JUNIOR_ADVISER to its current PART_TIME adviser.
enum SignatoryRole {
  PRESIDENT
  SECRETARY
  SENIOR_ADVISER
  JUNIOR_ADVISER
  DEAN
  SOA
  OSAS
}

enum SignatureStepStatus {
  LOCKED
  CURRENT
  SIGNED
  RETURNED
  REJECTED
}

enum RouteState {
  IN_PROGRESS
  COMPLETED
  RETURNED_FOR_REVISION
  REJECTED
}

model SignatureRoute {
  id          String     @id @default(cuid())
  // Parent document: "Recognition" | "ActivityProposal" | "AccomplishmentReport" | SF form key
  entityType  String
  entityId    String
  formKey     String
  title       String?
  state       RouteState @default(IN_PROGRESS)
  version     Int        @default(1)
  createdById String
  createdBy   User       @relation("SignatureRouteCreator", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  steps SignatureStep[]

  @@unique([entityType, entityId])
  @@index([formKey])
}

model SignatureStep {
  id              String              @id @default(cuid())
  routeId         String
  route           SignatureRoute      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  order           Int
  role            SignatoryRole
  // Resolved concrete signer once known (org officer / current adviser /
  // college dean). Null for office slots (SOA/OSAS/DEAN until resolved).
  signerId        String?
  signer          User?               @relation("SignatureStepSigner", fields: [signerId], references: [id])
  status          SignatureStepStatus @default(LOCKED)
  signedAt        DateTime?
  signatureImage  String?
  signatureTyped  String?
  signatureMethod String?
  comment         String?
  actedById       String?
  actedBy         User?               @relation("SignatureStepActor", fields: [actedById], references: [id])
  // Tamper-evident attachment §: at sign time the signer, role, method,
  // timestamp and a canonical content hash of the routed document are chained
  // so any later change to an earlier link breaks verification.
  contentHash     String?
  prevChainHash   String?
  chainHash       String?

  @@unique([routeId, order])
  @@index([routeId, status])
}

// ---------------------------------------------------------------------------
// Deadlines (created by OSAS, manageable by SOA where authorized)
// ---------------------------------------------------------------------------

enum DeadlineProcess {
  RECOGNITION
  RENEWAL
  ACTIVITY
  ACCOMPLISHMENT
  OTHER
}

enum DeadlineScope {
  ALL
  MOTHER
  CHILD
  INDEPENDENT
}

model Deadline {
  id             String          @id @default(cuid())
  name           String
  process        DeadlineProcess
  academicYear   String
  startDate      DateTime
  dueDate        DateTime
  scopeType      DeadlineScope   @default(ALL)
  scopeCollegeId String?
  scopeCollege   College?        @relation(fields: [scopeCollegeId], references: [id])
  instructions   String?
  isActive       Boolean         @default(true)
  createdById    String
  createdBy      User            @relation("DeadlineCreator", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  financialSubmissions FinancialSubmission[]

  @@index([academicYear])
  @@index([process])
}

// ---------------------------------------------------------------------------
// Attachments (files stored on disk; metadata here)
// ---------------------------------------------------------------------------

// Which accreditation requirement an uploaded file satisfies (SF-001
// checklist). Only meaningful for Recognition attachments; other parents
// leave it null.
enum AttachmentKind {
  CONSTITUTION
  PLAN_OF_ACTIVITIES
  ACCOMPLISHMENT_REPORTS
  ADVISER_COMMITMENT
  CERTIFICATION
  FINANCIAL_REPORT
  // Additional non-ISO document requirement — supporting evidence files that
  // are not one of the six official SF forms.
  SUPPORTING_DOCUMENTS
  // Financial-module file roles (tagged on FinancialSubmission attachments).
  FINANCIAL_DOCUMENT
  FINANCIAL_SUPPORTING
}

// The institutional process a financial requirement belongs to. Maps onto the
// existing Deadline.process values so deadlines drive overdue determination.
enum FinancialProcess {
  RECOGNITION
  RENEWAL
  ACTIVITY
  OTHER
}

// Single consistent financial workflow taxonomy (§13). Overdue is a derived
// flag (an applicable deadline passed without a filed/settled submission),
// not a stored status.
enum FinancialSubmissionStatus {
  DRAFT
  INCOMPLETE
  SUBMITTED
  UNDER_REVIEW
  RETURNED
  RESUBMITTED
  APPROVED
  ARCHIVED
}

model Attachment {
  id           String          @id @default(cuid())
  // Parent record: "Recognition" | "ActivityProposal" | "AccomplishmentReport"
  // | "FinancialSubmission"
  entityType   String
  entityId     String
  fileName     String
  notes       String?
  storedName   String          @unique
  mimeType     String
  sizeBytes    Int
  kind         AttachmentKind?
  // Submission revision this file belongs to (financial files only; others
  // stay at the default 1 so history is never rewritten).
  version      Int             @default(1)
  uploadedById String
  uploadedBy   User            @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime        @default(now())

  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// In-app notifications (Part 9 - workflow assistant)
// Fan-out rows per recipient; created as a side effect of workflow events.
// Priority drives the notification-center grouping; category drives the
// user preference toggles (SIGNATURE/REVIEW/DEADLINE are mandatory and can
// never be disabled because they carry an action the user must perform).
// organizationId + entityType/entityId scope every row so reads and actions
// can be authorization-checked server-side (never trust the client-supplied
// id alone). `dedupKey` makes deadline reminders and grouped events
// idempotent — a reminder/group is created once and never re-sent.
// ---------------------------------------------------------------------------

enum NotificationPriority {
  ACTION_REQUIRED // red - the user must act
  ATTENTION       // yellow - relevant soon (upcoming deadlines, interviews)
  INFO            // blue - something changed, no action
  SUCCESS         // green - a workflow step completed/approved
}

enum NotificationCategory {
  SIGNATURE  // signature requests (mandatory)
  REVIEW     // a document/workflow requires review approval (mandatory)
  REVISION   // returned for revision (mandatory while action pending)
  APPROVAL   // approve/reject outcomes on documents
  DEADLINE   // deadline announcements + reminders (due/overdue mandatory)
  INTERVIEW  // interview scheduling
  SUBMISSION // a document/financial submission was filed
  MEMBERSHIP // membership applications + decisions
  ACTIVITY   // activity proposals, monitoring, scheduling
  REPORT     // accomplishment reports
  FINANCIAL  // financial submissions/comments
  FOLLOW_UP  // recognition follow-up items
  SYSTEM     // platform announcements
}

model Notification {
  id             String                @id @default(cuid())
  userId         String
  user           User                  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type           String
  category       NotificationCategory  @default(SYSTEM)
  priority       NotificationPriority  @default(INFO)
  title          String
  body           String?
  link           String?
  // Organizational/document scope for authorization checks.
  organizationId String?
  organization   Organization?         @relation("NotificationOrg", fields: [organizationId], references: [id], onDelete: Cascade)
  // Academic year the notification belongs to. Relationship-scoped visibility
  // (Fix #2) matches a user's current org relationship for THIS year at read
  // time; past-AY rows stay visible in history but never as current tasks.
  academicYear   String?
  entityType     String?
  entityId       String?
  // "Why am I seeing this?" explanation rendered on the detail row.
  reason         String?
  // Grouped rows fold >1 related events into one row (e.g. "4 requirements
  // need attention"); groupCount records how many events were merged.
  groupKey       String?
  groupCount     Int                   @default(1)
  // Idempotency: deadline reminders / grouped sends carry a unique key so a
  // lazy pass can never create a duplicate.
  dedupKey       String?               @unique
  expiresAt      DateTime?
  readAt         DateTime?
  archivedAt     DateTime?
  createdAt      DateTime              @default(now())

  @@index([userId, readAt, createdAt])
  @@index([organizationId])
  @@index([academicYear])
  @@index([entityType, entityId])
  @@index([userId, archivedAt])
}

model NotificationPreference {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation("NotificationPreferenceOwner", fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  enabled   Boolean              @default(true)
  updatedAt DateTime             @updatedAt

  @@unique([userId, category])
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String
  entityType    String
  entityId      String?
  entityLabel   String?
  previousState Json?
  newState      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Financial compliance module (Part 12 - document/process compliance, NOT an
// accounting system). A FinancialRequirement is a configurable document a
// process requires; a FinancialSubmission is one org's instance for an
// academic year, routed through the same signature chain as the printed SF
// forms. Status transitions are enforced in src/lib/financial.ts.
// ---------------------------------------------------------------------------

model FinancialRequirement {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  process     FinancialProcess @default(RECOGNITION)
  // Signatory chain for this requirement; empty = canonical default.
  signers     SignatoryRole[]
  isActive    Boolean          @default(true)
  createdById String
  createdBy   User             @relation("FinancialRequirementCreator", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  submissions FinancialSubmission[]

  @@index([process, isActive])
}

model FinancialSubmission {
  id             String                    @id @default(cuid())
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirementId  String
  requirement    FinancialRequirement      @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  academicYear   String
  status         FinancialSubmissionStatus @default(DRAFT)
  // Mirrors SignatureRoute.version (increments on each reviewer return).
  version        Int                       @default(1)
  deadlineId     String?
  deadline       Deadline?                 @relation(fields: [deadlineId], references: [id])
  submittedAt    DateTime?
  resubmittedAt  DateTime?
  decidedAt      DateTime?
  decidedById    String?
  decidedBy      User?                     @relation("FinancialSubmissionDecidedBy", fields: [decidedById], references: [id])
  archivedAt     DateTime?
  archivedById   String?
  archivedBy     User?                     @relation("FinancialSubmissionArchiver", fields: [archivedById], references: [id])
  createdById    String
  createdBy      User                      @relation("FinancialSubmissionCreator", fields: [createdById], references: [id])
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  comments FinancialComment[]

  @@unique([organizationId, academicYear, requirementId])
  @@index([organizationId, academicYear])
  @@index([status])
}

model FinancialComment {
  id           String              @id @default(cuid())
  submissionId String
  submission   FinancialSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId     String
  author       User                @relation("FinancialCommentAuthor", fields: [authorId], references: [id])
  body         String
  createdAt    DateTime            @default(now())

  @@index([submissionId])
}

/// Official LSPU-OSAS form templates (SF-001..SF-006). FIXED institutional
/// documents: a new OSAS release creates a NEW row (version), it never edits
/// one in place — historical documents keep the version they were issued under.
model FormTemplate {
  id              String   @id @default(cuid())
  formCode        String   @unique // e.g. "LSPU-OSAS-SF-001"
  formName        String
  templateVersion String // e.g. "Rev. 109 November 2020"
  effectiveDate   DateTime
  status          String   @default("ACTIVE") // ACTIVE | SUPERSEDED | ARCHIVED
  referenceFile   String? // source DOCX this digitization is validated against
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// Form draft overrides — stores editable field values per (form, org, AY).
// The OFFICIAL DOCX remains the source of truth; these values are merged into
// FormData at export time so signatures always bind to the rendered PDF.
// ---------------------------------------------------------------------------

model FormDocument {
  id             String   @id @default(cuid())
  formKey        String   // SF001..SF006
  organizationId String
  academicYear   String
  data           Json     @default("{}") // FormDraftData overrides
  version        Int      @default(1)
  submittedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  versions       FormDocumentVersion[]

  @@unique([formKey, organizationId, academicYear])
  @@index([organizationId])
}

model FormDocumentVersion {
  id             String   @id @default(cuid())
  formDocumentId String
  formDocument   FormDocument @relation(fields: [formDocumentId], references: [id], onDelete: Cascade)
  version        Int
  action         String   // DRAFT_SAVED | SUBMITTED | REVISION_RESUBMITTED
  note           String?
  data           Json
  actorId        String?
  createdAt      DateTime @default(now())

  @@index([formDocumentId])
}
