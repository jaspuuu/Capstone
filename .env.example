# ORGanIZE environment template — copy to `.env` (never commit .env).

# PostgreSQL connection string (local dev, or a hosted one for production).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/organize"

# Optional — cookie name for sessions. Defaults to "organize_session".
SESSION_COOKIE_NAME="organize_session"

# Optional — enables @vercel/blob-backed uploads. Leave empty to use the
# next storage option instead. On Vercel, never set both this and Supabase.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Optional — Supabase Storage for uploads (production). Server-side only;
# never expose these to the browser. When both BLOB_READ_WRITE_TOKEN and
# SUPABASE_URL/KEY are set, Blob takes precedence.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="..."
# SUPABASE_STORAGE_BUCKET="organize-attachments"

# Optional — where local-disk uploads are stored (default: ./storage/uploads).
# ATTACHMENT_STORAGE_DIR="C:/path/to/uploads"

# Optional — directory holding the official OSAS master DOCX templates
# (default: ./templates/osas). Must point at the six SF-001..SF-006 masters.
# OSAS_TEMPLATES_DIR="C:/path/to/templates/osas"

# Optional — Google sign-in. Without these the button shows a "not configured"
# notice. Redirect URI must be <origin>/api/auth/google/callback.
# GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_SECRET="..."